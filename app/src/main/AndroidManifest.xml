<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/pan_logo_icon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/pan_logo_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.RecipeBook"
        tools:targetApi="31">

        <activity
            android:name=".f_Profile.ProfileActivity"
            android:exported="false" />
        <activity
            android:name=".e_RecipeDetails.RecipeDetailsActivity"
            android:exported="false" />
        <activity
            android:name=".d_AddEditRecipe.OperationRecipeActivity"
            android:exported="false"/>
        <activity
            android:name=".c_Home.HomeActivity"
            android:exported="false" />
        <activity
            android:name=".b_RegisterToTheApp.RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".a_SplashScreen.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>