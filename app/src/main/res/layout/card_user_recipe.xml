<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="10dp"
        android:paddingHorizontal="2dp">
        <ImageView
            android:id="@+id/recipeImageUC"
            android:layout_width="200dp"
            android:layout_height="200dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:src="@drawable/pan_logo_icon"/>

        <TextView
            android:id="@+id/recipeTitleUC"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Recipe title"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/recipeImageUC"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/recipeImageUC"
            app:layout_constraintTop_toTopOf="@id/recipeImageUC"
            app:layout_constraintVertical_bias="0.25" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/deleteButtonUC"
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/recipeImageUC"
            app:layout_constraintTop_toBottomOf="@id/recipeTitleUC"
            app:layout_constraintEnd_toStartOf="@id/editButtonUC"
            android:background="@drawable/shape_delete_button"
            android:src="@drawable/icon_delete"/>
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/editButtonUC"
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/deleteButtonUC"
            app:layout_constraintTop_toBottomOf="@id/recipeTitleUC"
            android:src="@drawable/icon_edit"
            android:background="@drawable/shape_edit_button"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>